# Copy this file to .env and fill it in. Never commit .env.

# Bearer token shared with rwatch (same value on both sides).
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# Host interface and port where the console is published.
# Dev (ThinkPad): 127.0.0.1
# Pi: 192.168.8.182 (eth0, router side). Never the wlan0 address.
CONSOLE_BIND_IP=127.0.0.1
CONSOLE_PORT=8080
